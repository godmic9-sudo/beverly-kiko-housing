# Local dev: copy to .env.local. Production: add the same names in Vercel > Settings > Environment Variables.

# Supabase: Project > Connect (or Settings > Database) > "Transaction pooler" connection string (port 6543).
# Replace [YOUR-PASSWORD]. If the password has special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Auth.js: a long random string. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Admin login. Created automatically on first request; changing the password here and redeploying resets it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password-at-least-12-chars

# Nylon Pay (sandbox first: npk_test_ / nps_test_)
NYLONPAY_API_KEY=npk_test_xxxxxxxx
NYLONPAY_API_SECRET=nps_test_xxxxxxxx

# Optional but recommended: lets Nylon confirm payments even if the tenant closes the page
NYLONPAY_WEBHOOK_SECRET=
