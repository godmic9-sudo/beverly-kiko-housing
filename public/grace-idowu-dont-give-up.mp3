		data.forEach(function (r) {
			h += '<a class="cnx-di" href="' + esc(r.u) + '">' +
				(r.i ? '<img class="cnx-dt" src="' + esc(r.i) + '" alt="" loading="lazy">' : '<span class="cnx-dt"></span>') +
				'<span><span class="cnx-drop-title notranslate" translate="no">' + esc(r.t) + '</span>' +
				'<span class="cnx-dy" style="display:block">' + esc(r.y) + '</span></span></a>';
		});
