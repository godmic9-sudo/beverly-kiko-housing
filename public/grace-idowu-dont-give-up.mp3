<style id="cnht-css">#cnx-nav{--cnx-bg:#ffffff;--cnx-border:#e8e8e8;--cnx-div:#f0f0f0;--cnx-hover:#f5f9f6;--cnx-circle:#e8f3eb;--cnx-icon:#1a472a;--cnx-label:#555555;--cnx-hlc:#fff8ec;--cnx-hl:#d4880a;--cnx-ac:#1a472a;--cnx-ai:#ffffff;--cnx-btn:#1a472a;--cnx-btxt:#ffffff;--cnx-isz:38px;--cnx-lsz:8.5px;--cnx-max:760px;}#cnx-nav{display:block!important;position:relative!important;z-index:50!important;clear:both!important;width:100%!important;margin:0!important;padding:0!important;background:var(--cnx-bg)!important;border-bottom:1px solid var(--cnx-border)!important;box-sizing:border-box!important;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Verdana,Arial,sans-serif!important;line-height:1.2!important;text-align:left!important}
#cnx-nav[hidden]{display:none!important}
#cnx-nav *{box-sizing:border-box!important}
#cnx-nav .cnx-in{max-width:var(--cnx-max)!important;margin:0 auto!important;padding:0!important}
#cnx-nav .cnx-row{display:flex!important;align-items:stretch!important;margin:0!important;padding:0!important;border-bottom:1px solid var(--cnx-div)!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none!important;-webkit-overflow-scrolling:touch!important}
#cnx-nav .cnx-row::-webkit-scrollbar{display:none!important}
#cnx-nav .cnx-item{flex:1 0 62px!important;min-width:62px!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:6px!important;margin:0!important;padding:10px 4px!important;text-decoration:none!important;border:0!important;border-right:1px solid var(--cnx-div)!important;background:transparent!important;box-shadow:none!important;transition:background .15s!important;-webkit-tap-highlight-color:transparent!important}
#cnx-nav .cnx-item:last-child{border-right:0!important}
#cnx-nav .cnx-item:hover,#cnx-nav .cnx-item:active{background:var(--cnx-hover)!important}
#cnx-nav .cnx-ic{width:var(--cnx-isz)!important;height:var(--cnx-isz)!important;border-radius:50%!important;display:flex!important;align-items:center!important;justify-content:center!important;background:var(--cnx-circle)!important;color:var(--cnx-icon)!important;margin:0!important;padding:0!important}
#cnx-nav .cnx-ic svg{width:calc(var(--cnx-isz) * .47)!important;height:calc(var(--cnx-isz) * .47)!important;display:block!important;fill:none!important;stroke:currentColor!important;stroke-width:1.8!important;stroke-linecap:round!important;stroke-linejoin:round!important}
#cnx-nav .cnx-ic svg.cnx-fill{fill:currentColor!important;stroke:none!important}
#cnx-nav .cnx-lb{font-size:var(--cnx-lsz)!important;font-weight:700!important;color:var(--cnx-label)!important;letter-spacing:.04em!important;text-transform:uppercase!important;white-space:nowrap!important;line-height:1.1!important;margin:0!important}
#cnx-nav.cnx-iconly .cnx-lb{display:none!important}
#cnx-nav .cnx-hl .cnx-ic{background:var(--cnx-hlc)!important;color:var(--cnx-hl)!important}
#cnx-nav .cnx-hl .cnx-lb{color:var(--cnx-hl)!important}
#cnx-nav .cnx-on .cnx-ic{background:var(--cnx-ac)!important;color:var(--cnx-ai)!important}
#cnx-nav .cnx-on .cnx-lb{color:var(--cnx-icon)!important}
#cnx-nav .cnx-find{position:relative!important;padding:8px 10px!important;margin:0!important;background:var(--cnx-bg)!important}
#cnx-nav .cnx-find-in{display:flex!important;align-items:center!important;margin:0!important;padding:0!important;background:#f5f5f5!important;border:1.5px solid #e0e0e0!important;border-radius:8px!important;overflow:hidden!important;transition:border-color .2s!important}
#cnx-nav .cnx-find-in:focus-within{border-color:var(--cnx-btn)!important;background:#fff!important}
#cnx-nav .cnx-mag{width:16px!important;height:16px!important;flex:none!important;margin:0 0 0 10px!important;fill:none!important;stroke:#999!important;stroke-width:2!important;stroke-linecap:round!important}
#cnx-nav .cnx-find-in:focus-within .cnx-mag{stroke:var(--cnx-btn)!important}
#cnx-nav .cnx-q{flex:1!important;min-width:0!important;width:auto!important;height:auto!important;margin:0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;padding:9px 8px!important;font-size:14px!important;color:#222!important;outline:none!important}
#cnx-nav .cnx-q::placeholder{color:#aaa!important;font-size:13px!important}
#cnx-nav .cnx-go{flex:none!important;margin:0!important;border:0!important;border-radius:0!important;background:var(--cnx-btn)!important;color:var(--cnx-btxt)!important;padding:10px 14px!important;font-size:13px!important;font-weight:700!important;line-height:1!important;cursor:pointer!important;white-space:nowrap!important;text-transform:none!important;box-shadow:none!important}
#cnx-nav .cnx-drop{display:block!important;position:absolute!important;top:calc(100% - 10px)!important;left:10px!important;right:10px!important;z-index:99999!important;background:#fff!important;border:1.5px solid var(--cnx-btn)!important;border-top:0!important;border-radius:0 0 10px 10px!important;overflow:hidden!important;box-shadow:0 6px 16px rgba(0,0,0,.1)!important}
#cnx-nav .cnx-drop[hidden]{display:none!important}
#cnx-nav .cnx-di{display:flex!important;align-items:center!important;gap:10px!important;padding:9px 12px!important;margin:0!important;text-decoration:none!important;border-bottom:1px solid #f5f5f5!important;background:#fff!important}
#cnx-nav .cnx-di:hover{background:var(--cnx-hover)!important}
#cnx-nav .cnx-dt{width:36px!important;height:36px!important;flex:none!important;border-radius:5px!important;object-fit:cover!important;background:var(--cnx-circle)!important;margin:0!important}
#cnx-nav .cnx-drop-title{font-size:13px!important;font-weight:700!important;color:var(--cnx-icon)!important;line-height:1.3!important;display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important}
#cnx-nav .cnx-dy{font-size:11px!important;color:#888!important;margin-top:2px!important}
#cnx-nav .cnx-dm{padding:14px!important;text-align:center!important;font-size:13px!important;color:#999!important}
#cnx-nav .cnx-all{display:block!important;text-align:center!important;padding:10px!important;font-size:12px!important;font-weight:700!important;color:var(--cnx-icon)!important;text-decoration:none!important;background:var(--cnx-hover)!important;border-top:1px solid #e0e0e0!important}
#cnx-nav.cnx-stick{position:-webkit-sticky!important;position:sticky!important;top:0!important;z-index:9990!important}
