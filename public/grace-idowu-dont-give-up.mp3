<script type="text/rocketlazyloadscript">document.addEventListener('click', function (event) {
  const link = event.target.closest('a[data-direct-link-id]');
  if (!link) return;

  navigator.sendBeacon(
    '/adCodes/direct-link-click.php',
    new URLSearchParams({
      id: link.dataset.directLinkId,
      name: link.dataset.directLinkName || link.dataset.directLinkId
    })
  );
}, true);

(function(){
  var TRACK_ENDPOINT = "https://www.ceenaija.com/adCodes/direct-link-click.php";

  function isMp3Link(a){
    if(!a || !a.href) return false;
    try{
      var url = new URL(a.href, window.location.href);
      return /\.mp3(\?.*)?$/i.test(url.pathname + (url.search || ''));
    }catch(e){ return false; }
  }

  function slug(str){
    return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }

  function nameFromFilename(str){
    var withoutExt = str.replace(/\.mp3$/i, '');
    var spaced = withoutExt.replace(/[-_]+/g, ' ').trim();
    return spaced.replace(/\b\w/g, function(c){ return c.toUpperCase(); });
  }

  function track(id, name){
    try{
      fetch(TRACK_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'id=' + encodeURIComponent(id) + '&name=' + encodeURIComponent(name),
        keepalive: true
      }).catch(function(){});
    }catch(e){}
  }

  // Passive, sitewide: fires on every .mp3 link, on every page, with no
  // markup changes needed — but never touches the click itself, so the
  // download always proceeds exactly as it would without this script.
  document.addEventListener('click', function(e){
    var a = e.target.closest('a');
    if(!a || !isMp3Link(a)) return;
    if(a.hasAttribute('data-direct-link-id')) return; // already tracked by the named-button script — skip to avoid double-counting

    var url = new URL(a.href, window.location.href);
    var filename = decodeURIComponent(url.pathname.split('/').pop() || 'unknown.mp3');
    var id = 'mp3auto-' + slug(filename.replace(/\.mp3$/i, ''));
    var name = nameFromFilename(filename);

    track(id, name);
    // no preventDefault — the real download happens exactly as it always did
  }, true);
})();</script>
