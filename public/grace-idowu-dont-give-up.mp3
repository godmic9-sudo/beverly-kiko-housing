				statusRow.innerHTML = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke="' + C.btn + '" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Your download has started</span>';
				card.appendChild(statusRow);

				groups.forEach(function (group, gi) {
