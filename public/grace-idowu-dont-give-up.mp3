	var C = window.cnxCfg || {}, done = false, mo;
	var AUTO = '.td-header-wrap,.td-header-template-wrap,.tdc-header-wrap,#masthead,header.site-header,.site-header,#header,header';
	function findHeader() {
		var list;
		if (C.sel) {
			try { return document.querySelector(C.sel); } catch (e) { C.sel = ''; }
		}
		list = document.querySelectorAll(AUTO);
		for (var i = 0; i < list.length; i++) {
			var el = list[i];
			if (el.closest('#cnx-nav,article,main,.entry-header,.td-post-header')) continue;
			if (el.parentElement && el.parentElement.closest(AUTO)) continue;
			return el;
		}
		return null;
	}
	function finish(src) {
		done = true;
		src.hidden = false;
		if (mo) mo.disconnect();
	}
	function tryPlace(final) {
		if (done) return;
		var src = document.getElementById('cnx-nav');
		if (!src) return;
		var h = findHeader();
		if (h && (h.nextElementSibling || final)) {
			if (C.pos === 'before') h.parentNode.insertBefore(src, h);
			else if (C.pos === 'inside') h.appendChild(src);
			else h.parentNode.insertBefore(src, h.nextSibling);
			finish(src);
		} else if (final) {
			document.body.insertBefore(src, document.body.firstChild);
			finish(src);
		}
	}
	if (window.MutationObserver) {
		mo = new MutationObserver(function () { tryPlace(false); });
		mo.observe(document.documentElement, { childList: true, subtree: true });
	}
	document.addEventListener('DOMContentLoaded', function () { tryPlace(true); });
})();</script>
