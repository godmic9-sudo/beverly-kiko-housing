	function allLink(v) {
		return '<a class="cnx-all" href="' + esc(C.home + '?s=' + encodeURIComponent(v)) + '">' + esc(C.txt.all) + ' &ldquo;' + esc(v) + '&rdquo; &rarr;</a>';
	}
	function render(v, data) {
		if (!data || !data.length) { show('<div class="cnx-dm">' + esc(C.txt.none) + ' &ldquo;' + esc(v) + '&rdquo;</div>'); return; }
